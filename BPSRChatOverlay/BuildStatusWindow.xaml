<Window x:Class="BPSRChatOverlay.BuildStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Status"
        Width="260"
        Height="42"
        MinWidth="180"
        MaxWidth="400"
        MinHeight="29.4"
        MaxHeight="63"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged">
    <Border x:Name="RootBorder"
            Padding="8,5"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="#704C566A"
            Background="#D91A1E27">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform"
                            ScaleX="1"
                            ScaleY="1" />
        </Border.LayoutTransform>
        <Grid x:Name="StatusContentGrid"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WarningText"
                       Grid.Column="0"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="#FFFFC857"
                       Text="⚠"
                       Visibility="Collapsed" />
            <Border x:Name="TypeReadingHighlight"
                    Grid.Column="1"
                    Padding="4,1"
                    CornerRadius="3">
                <TextBlock x:Name="TypeText"
                           VerticalAlignment="Center"
                           FontFamily="Meiryo UI"
                           FontSize="15"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <TextBlock x:Name="SeparatorText"
                       Grid.Column="2"
                       Margin="7,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="#FF9AA4B5"
                       Text="｜" />
            <Border x:Name="CultivateReadingHighlight"
                    Grid.Column="3"
                    Padding="4,1"
                    CornerRadius="3">
                <TextBlock x:Name="CultivateText"
                           VerticalAlignment="Center"
                           FontFamily="Meiryo UI"
                           FontSize="15"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <Button x:Name="RegisterCombinationButton"
                    Grid.Column="4"
                    Margin="7,0,0,0"
                    Padding="5,2"
                    VerticalAlignment="Center"
                    Background="#FF3C485D"
                    BorderBrush="#FF66748C"
                    BorderThickness="1"
                    Foreground="White"
                    FontFamily="Meiryo UI"
                    FontSize="11"
                    Content="登録"
                    ToolTip="現在の組み合わせを登録"
                    Visibility="Collapsed"
                    Click="RegisterCombinationButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FF46536A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FF293344" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
