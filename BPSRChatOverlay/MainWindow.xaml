<Window x:Class="BPSRChatOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BPSRChatOverlay.Converters"
        Title="BPSR Chat Overlay - 通信確認"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:ChannelNameConverter x:Key="ChannelNameConverter"/>
        <converters:ChannelBrushConverter x:Key="ChannelBrushConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button
                DockPanel.Dock="Right"
                Content="設定"
                Width="70"
                Click="SettingsButton_Click"/>

            <TextBlock
                Text="BPSR Chat Overlay 通信確認"
                FontSize="24"
                FontWeight="Bold"/>
        </DockPanel>

        <Border
            Grid.Row="1"
            Padding="14"
            Margin="0,0,0,16"
            BorderBrush="#808080"
            BorderThickness="1"
            CornerRadius="6">

            <StackPanel>
                <TextBlock
                    Text="パケット取得状況"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                <TextBlock
                    x:Name="CaptureStatusText"
                    Text="起動処理中..."
                    FontSize="14"/>

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock
                        x:Name="PacketCountText"
                        Text="Npcap取得パケット数: 0"
                        FontSize="14"
                        Margin="0,0,24,0"/>

                    <TextBlock
                        x:Name="GameMessageCountText"
                        Text="ゲームメッセージ検出数: 0"
                        FontSize="14"
                        Margin="0,0,24,0"/>

                    <TextBlock
                        x:Name="DequeuedMessageCountText"
                        Text="解析処理済みメッセージ数: 0"
                        FontSize="14"/>
                </WrapPanel>

                <TextBlock
                    x:Name="LastPacketTimeText"
                    Text="最終パケット取得時刻: 未取得"
                    FontSize="14"
                    Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <TextBlock
                    Text="受信チャット"
                    FontSize="18"
                    FontWeight="SemiBold"/>

                <TextBlock
                    x:Name="ChatCountText"
                    DockPanel.Dock="Right"
                    Text="受信件数: 0"
                    FontSize="14"
                    VerticalAlignment="Bottom"/>
            </DockPanel>

            <Border
                Grid.Row="1"
                BorderBrush="#808080"
                BorderThickness="1"
                CornerRadius="6">

                <ListBox
                    x:Name="ChatListBox"
                    ItemsSource="{Binding ChatMessages}"
                    BorderThickness="0"
                    FontSize="16"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                    Foreground="#707070"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding ChannelType, Converter={StaticResource ChannelNameConverter}}"
                                    Foreground="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding SenderName}"
                                    FontWeight="Bold"
                                    TextTrimming="CharacterEllipsis"
                                    Margin="6,0"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>
