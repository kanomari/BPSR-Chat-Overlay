<Window x:Class="BPSRChatOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:BPSRChatOverlay.Converters"
        Title=""
        Width="800"
        Height="600"
        MinWidth="280"
        MinHeight="100"
        FontFamily="Meiryo UI"
        Foreground="#FFF4F6F8"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:ChannelNameConverter x:Key="ChannelNameConverter"/>
        <converters:ChannelBrushConverter x:Key="ChannelBrushConverter"/>
        <converters:ChatHighlightConverter x:Key="ChatHighlightConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <system:Double x:Key="ChatTextOpacity">1.0</system:Double>
        <system:Double x:Key="WindowDecorationOpacity">1.0</system:Double>
        <system:Double x:Key="ChatBackgroundOpacity">1.0</system:Double>
        <Duration x:Key="ChatRowAnimationDuration">0:0:0.220</Duration>
        <system:Double x:Key="ChatRowAnimationOffsetY">6</system:Double>
        <Duration x:Key="NewChatHighlightDuration">0:0:0.880</Duration>
        <Color x:Key="NewChatHighlightColor">#40678EB8</Color>
        <Storyboard x:Key="NewChatHighlightStoryboard">
            <ColorAnimationUsingKeyFrames
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                Duration="{StaticResource NewChatHighlightDuration}">
                <LinearColorKeyFrame
                    KeyTime="0:0:0"
                    Value="Transparent"/>
                <EasingColorKeyFrame
                    KeyTime="0:0:0.180"
                    Value="{StaticResource NewChatHighlightColor}">
                    <EasingColorKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseOut"/>
                    </EasingColorKeyFrame.EasingFunction>
                </EasingColorKeyFrame>
                <LinearColorKeyFrame
                    KeyTime="0:0:0.260"
                    Value="{StaticResource NewChatHighlightColor}"/>
                <EasingColorKeyFrame
                    KeyTime="0:0:0.880"
                    Value="Transparent">
                    <EasingColorKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseIn"/>
                    </EasingColorKeyFrame.EasingFunction>
                </EasingColorKeyFrame>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <SolidColorBrush x:Key="WindowBorderBrush" Color="#FF303640"/>
        <SolidColorBrush x:Key="TitleBarOverlayBrush" Color="#D9080B10"/>
        <SolidColorBrush x:Key="TitleBarDividerBrush" Color="#FF242A33"/>
        <SolidColorBrush x:Key="TitleButtonForegroundBrush" Color="#FFAEB6C2"/>
        <SolidColorBrush x:Key="TitleButtonHoverBrush" Color="#FF242B35"/>
        <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#FFC42B3A"/>
        <SolidColorBrush x:Key="ChatToggleOnBackgroundBrush" Color="#E63A4656"/>
        <SolidColorBrush x:Key="ChatToggleOffBackgroundBrush" Color="#B0181E27"/>
        <SolidColorBrush x:Key="ChatToggleBorderBrush" Color="#B06E7B8B"/>
        <SolidColorBrush x:Key="ChatToggleOffBorderBrush" Color="#90505A66"/>
        <SolidColorBrush x:Key="ChatToggleOnForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ChatToggleOffForegroundBrush" Color="#FF89939F"/>
        <SolidColorBrush x:Key="TimestampBrush" Color="#FF929AA5"/>
        <SolidColorBrush x:Key="ChatSeparatorBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="ChatZebraStripeEnabledBrush" Color="#18162232"/>
        <SolidColorBrush x:Key="ChatZebraStripeBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="DebugPanelBrush" Color="#E512161C"/>
        <SolidColorBrush x:Key="DebugPanelBorderBrush" Color="#FF303640"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#665F6975"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#99798594"/>
        <SolidColorBrush x:Key="ScrollThumbDraggingBrush" Color="#CC929EAD"/>
        <Color x:Key="ChatTextShadowColor">#FF203040</Color>
        <DropShadowEffect
            x:Key="ChatTextShadowEffect"
            Color="{DynamicResource ChatTextShadowColor}"
            Opacity="0.30"
            Direction="315"
            ShadowDepth="1"
            BlurRadius="1.5"
            RenderingBias="Performance"/>
        <Thickness x:Key="ContentMargin">4</Thickness>
        <Thickness x:Key="ChatRowMargin">4,1</Thickness>
        <Thickness x:Key="ChatRowPadding">3,2</Thickness>
        <GridLength x:Key="TitleBarRowHeight">20</GridLength>
        <GridLength x:Key="TimeColumnWidth">40</GridLength>
        <GridLength x:Key="SenderNameColumnWidth">108</GridLength>
        <system:Double x:Key="ChatColorBandWidth">3</system:Double>
        <GridLength x:Key="LeftChatColorBandWidth">3</GridLength>
        <GridLength x:Key="RightChatColorBandWidth">0</GridLength>
        <system:Double x:Key="TitleButtonWidth">28</system:Double>
        <system:Double x:Key="ChatToggleButtonWidth">26</system:Double>
        <system:Double x:Key="ChatToggleButtonHeight">16</system:Double>
        <Thickness x:Key="ChatToggleButtonMargin">1.5,0</Thickness>
        <Thickness x:Key="ChatToggleGroupMargin">0,0,12,0</Thickness>
        <Thickness x:Key="FeatureToggleGroupMargin">0,0,6,0</Thickness>
        <system:Double x:Key="TimestampFontSize">11.5</system:Double>
        <Geometry x:Key="FilterIconGeometry">
            M 1,2 L 15,2 L 10,8 L 10,14 L 6,12 L 6,8 Z
        </Geometry>
        <Geometry x:Key="HighlightIconGeometry">
            M 8,0 L 9.5,5.5 L 15,7 L 9.5,8.5 L 8,14
            L 6.5,8.5 L 1,7 L 6.5,5.5 Z
            M 14,0 L 14.6,1.9 L 16,2.5 L 14.6,3.1
            L 14,5 L 13.4,3.1 L 12,2.5 L 13.4,1.9 Z
        </Geometry>

        <Style x:Key="TransparentTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="3.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{StaticResource ScrollThumbDraggingBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="True"
                            Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static ScrollBar.PageUpCommand}"
                                    Style="{StaticResource TransparentTrackButtonStyle}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource OverlayScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static ScrollBar.PageDownCommand}"
                                    Style="{StaticResource TransparentTrackButtonStyle}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="{StaticResource TitleButtonWidth}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TitleButtonForegroundBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TitleButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource TitleBarButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CloseButtonHoverBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="{StaticResource ChatToggleButtonWidth}"/>
            <Setter Property="Height" Value="{StaticResource ChatToggleButtonHeight}"/>
            <Setter Property="Margin" Value="{StaticResource ChatToggleButtonMargin}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource ChatToggleOffForegroundBrush}"/>
            <Setter Property="Background" Value="{StaticResource ChatToggleOffBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChatToggleOffBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ChatToggleOnForegroundBrush}"/>
                    <Setter Property="Background" Value="{StaticResource ChatToggleOnBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ChatToggleBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatRowTextGridStyle" TargetType="Grid">
            <Setter Property="Effect"
                    Value="{StaticResource ChatTextShadowEffect}"/>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding Tag.EnableChatTextShadow,
                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                    Value="False">
                    <Setter Property="Effect" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatMessageTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding Tag.EnableBoldMessageText,
                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                    Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="NewChatHighlight"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <SolidColorBrush Color="Transparent"/>
                                </Border.Background>
                            </Border>
                            <ContentPresenter
                                x:Name="AnimatedContent"
                                Opacity="0">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform
                                        Y="{StaticResource ChatRowAnimationOffsetY}"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                            <Border
                                Height="1"
                                Margin="4,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource ChatSeparatorBrush}"
                                IsHitTestVisible="False"
                                Visibility="{Binding Tag.ShowChatSeparators,
                                    RelativeSource={RelativeSource AncestorType={x:Type ListBox}},
                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="AnimatedContent"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="{StaticResource ChatRowAnimationDuration}">
                                            <DoubleAnimation.EasingFunction>
                                                <PowerEase
                                                    Power="4"
                                                    EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="AnimatedContent"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="{StaticResource ChatRowAnimationOffsetY}"
                                            To="0"
                                            Duration="{StaticResource ChatRowAnimationDuration}">
                                            <DoubleAnimation.EasingFunction>
                                                <PowerEase
                                                    Power="4"
                                                    EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger
                    Property="ItemsControl.AlternationIndex"
                    Value="1">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource ChatZebraStripeBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        Background="Transparent"
        CornerRadius="6">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TitleBarRowHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.RowSpan="2"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False"
                Opacity="{DynamicResource WindowDecorationOpacity}"/>

            <Grid
                x:Name="TitleBarRoot"
                Background="Transparent"
                IsHitTestVisible="True"
                PreviewMouseLeftButtonDown="TitleBarRoot_PreviewMouseLeftButtonDown">
                <Grid
                    IsHitTestVisible="False"
                    Opacity="{DynamicResource WindowDecorationOpacity}">
                    <Border
                        x:Name="MenuBackgroundBorder"
                        Background="#FF080B10"
                        CornerRadius="5,5,0,0"/>

                    <Border
                        Background="{StaticResource TitleBarOverlayBrush}"
                        CornerRadius="5,5,0,0"/>

                    <Border
                        BorderBrush="{StaticResource TitleBarDividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="5,5,0,0"/>
                </Grid>

                <Grid Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Background="Transparent"/>

                        <StackPanel
                            x:Name="ChatTogglePanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="{StaticResource ChatToggleGroupMargin}">
                            <ToggleButton Content="W"
                                          Tag="World"
                                          ToolTip="ワールド"
                                          Style="{StaticResource ChatToggleButtonStyle}"
                                          Click="ChatToggleButton_Click"/>
                            <ToggleButton Content="G"
                                          Tag="Guild"
                                          ToolTip="ギルド"
                                          Style="{StaticResource ChatToggleButtonStyle}"
                                          Click="ChatToggleButton_Click"/>
                            <ToggleButton Content="P"
                                          Tag="Party"
                                          ToolTip="パーティ"
                                          Style="{StaticResource ChatToggleButtonStyle}"
                                          Click="ChatToggleButton_Click"/>
                            <ToggleButton Content="Ch"
                                          Tag="Channel"
                                          ToolTip="チャンネル"
                                          Style="{StaticResource ChatToggleButtonStyle}"
                                          Click="ChatToggleButton_Click"/>
                            <ToggleButton Content="N"
                                          Tag="Newbie"
                                          ToolTip="初心者チャット"
                                          Style="{StaticResource ChatToggleButtonStyle}"
                                          Click="ChatToggleButton_Click"/>
                            <ToggleButton Content="✉"
                                          Tag="Talk"
                                          ToolTip="トーク"
                                          Style="{StaticResource ChatToggleButtonStyle}"
                                          Click="ChatToggleButton_Click"/>
                        </StackPanel>

                        <StackPanel
                            x:Name="FeatureTogglePanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="{StaticResource FeatureToggleGroupMargin}">
                            <ToggleButton
                                x:Name="ChatFilterToggleButton"
                                Tag="ChatFilter"
                                Style="{StaticResource ChatToggleButtonStyle}"
                                Click="FeatureToggleButton_Click">
                                <Viewbox Width="11" Height="11">
                                    <Path
                                        Data="{StaticResource FilterIconGeometry}"
                                        Fill="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                                </Viewbox>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="MentionHighlightToggleButton"
                                Tag="MentionHighlight"
                                Style="{StaticResource ChatToggleButtonStyle}"
                                Click="FeatureToggleButton_Click">
                                <Viewbox Width="11" Height="11">
                                    <Path
                                        Data="{StaticResource HighlightIconGeometry}"
                                        Fill="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                                </Viewbox>
                            </ToggleButton>
                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="SettingsButton_Click"/>

                        <Button
                            Grid.Column="4"
                            Content="×"
                            FontSize="14"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="ExitButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="{StaticResource ContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    x:Name="DebugPanel"
                    Padding="10"
                    Margin="0,0,0,4"
                    Background="{StaticResource DebugPanelBrush}"
                    BorderBrush="{StaticResource DebugPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">

                    <StackPanel>
                        <TextBlock
                            Text="パケット取得状況"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"/>

                        <TextBlock
                            x:Name="CaptureStatusText"
                            Text="起動処理中..."
                            FontSize="14"/>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock
                                x:Name="PacketCountText"
                                Text="Npcap取得パケット数: 0"
                                FontSize="14"
                                Margin="0,0,24,0"/>

                            <TextBlock
                                x:Name="GameMessageCountText"
                                Text="ゲームメッセージ検出数: 0"
                                FontSize="14"
                                Margin="0,0,24,0"/>

                            <TextBlock
                                x:Name="DequeuedMessageCountText"
                                Text="解析処理済みメッセージ数: 0"
                                FontSize="14"/>
                        </WrapPanel>

                        <TextBlock
                            x:Name="LastPacketTimeText"
                            Text="最終パケット取得時刻: 未取得"
                            FontSize="14"
                            Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Border
                        x:Name="ChatBackgroundBorder"
                        Background="Black"
                        CornerRadius="4"
                        Opacity="{DynamicResource ChatBackgroundOpacity}"/>

                    <Border
                        Background="Transparent">

                        <ListBox
                            x:Name="ChatListBox"
                            AlternationCount="2"
                            ItemsSource="{Binding ChatMessages}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="15"
                            Padding="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.Resources>
                                <Style
                                    BasedOn="{StaticResource OverlayScrollBarStyle}"
                                    TargetType="ScrollBar"/>
                            </ListBox.Resources>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="{StaticResource ChatRowMargin}"
                                        CornerRadius="2">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource ChatHighlightConverter}">
                                                <Binding Path="IsMention"/>
                                                <Binding Path="IsTalkHighlightVisible"/>
                                                <Binding Path="IsTalkHighlighted"/>
                                            </MultiBinding>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{DynamicResource LeftChatColorBandWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="{DynamicResource RightChatColorBandWidth}"/>
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                IsHitTestVisible="False"
                                                Background="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}, ConverterParameter=ChatText}"/>

                                            <Grid
                                                Grid.Column="1"
                                                Style="{StaticResource ChatRowTextGridStyle}"
                                                Margin="{StaticResource ChatRowPadding}"
                                                Opacity="{DynamicResource ChatTextOpacity}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{DynamicResource TimeColumnWidth}"/>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="{DynamicResource SenderNameColumnWidth}"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                    Foreground="{StaticResource TimestampBrush}"
                                                    FontSize="{StaticResource TimestampFontSize}"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ChannelType, Converter={StaticResource ChannelNameConverter}}"
                                                    Foreground="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}}"
                                                    FontSize="12"
                                                    FontWeight="Normal"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{Binding SenderName}"
                                                    Foreground="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}, ConverterParameter=ChatText}"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    Margin="3,0,6,0"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{Binding Message}"
                                                    Foreground="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}, ConverterParameter=ChatText}"
                                                    Style="{StaticResource ChatMessageTextBlockStyle}"
                                                    TextWrapping="Wrap"
                                                    VerticalAlignment="Top"/>
                                            </Grid>

                                            <Border
                                                Grid.Column="2"
                                                IsHitTestVisible="False"
                                                Background="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}, ConverterParameter=ChatText}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="ChatCountText"
                Grid.Row="0"
                Visibility="Collapsed"
                Text="受信件数: 0"/>
        </Grid>
    </Border>
</Window>
