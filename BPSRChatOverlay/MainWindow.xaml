<Window x:Class="BPSRChatOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:BPSRChatOverlay.Converters"
        Title=""
        Width="800"
        Height="600"
        MinWidth="280"
        MinHeight="100"
        FontFamily="Meiryo UI"
        Foreground="#FFF4F6F8"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:ChannelNameConverter x:Key="ChannelNameConverter"/>
        <converters:ChannelBrushConverter x:Key="ChannelBrushConverter"/>
        <converters:MentionHighlightConverter x:Key="MentionHighlightConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <system:Double x:Key="ChatTextOpacity">1.0</system:Double>
        <system:Double x:Key="WindowDecorationOpacity">1.0</system:Double>
        <system:Double x:Key="ChatBackgroundOpacity">1.0</system:Double>
        <Duration x:Key="ChatRowAnimationDuration">0:0:0.220</Duration>
        <system:Double x:Key="ChatRowAnimationOffsetY">6</system:Double>
        <Duration x:Key="NewChatHighlightDuration">0:0:0.880</Duration>
        <Color x:Key="NewChatHighlightColor">#40678EB8</Color>
        <Storyboard x:Key="NewChatHighlightStoryboard">
            <ColorAnimationUsingKeyFrames
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                Duration="{StaticResource NewChatHighlightDuration}">
                <LinearColorKeyFrame
                    KeyTime="0:0:0"
                    Value="Transparent"/>
                <EasingColorKeyFrame
                    KeyTime="0:0:0.180"
                    Value="{StaticResource NewChatHighlightColor}">
                    <EasingColorKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseOut"/>
                    </EasingColorKeyFrame.EasingFunction>
                </EasingColorKeyFrame>
                <LinearColorKeyFrame
                    KeyTime="0:0:0.260"
                    Value="{StaticResource NewChatHighlightColor}"/>
                <EasingColorKeyFrame
                    KeyTime="0:0:0.880"
                    Value="Transparent">
                    <EasingColorKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseIn"/>
                    </EasingColorKeyFrame.EasingFunction>
                </EasingColorKeyFrame>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <SolidColorBrush x:Key="WindowBorderBrush" Color="#FF303640"/>
        <SolidColorBrush x:Key="TitleBarOverlayBrush" Color="#D9080B10"/>
        <SolidColorBrush x:Key="TitleBarDividerBrush" Color="#FF242A33"/>
        <SolidColorBrush x:Key="TitleButtonForegroundBrush" Color="#FFAEB6C2"/>
        <SolidColorBrush x:Key="TitleButtonHoverBrush" Color="#FF242B35"/>
        <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#FFC42B3A"/>
        <SolidColorBrush x:Key="TimestampBrush" Color="#FF929AA5"/>
        <SolidColorBrush x:Key="ChatSeparatorBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="ChatZebraStripeEnabledBrush" Color="#18162232"/>
        <SolidColorBrush x:Key="ChatZebraStripeBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="DebugPanelBrush" Color="#E512161C"/>
        <SolidColorBrush x:Key="DebugPanelBorderBrush" Color="#FF303640"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#665F6975"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#99798594"/>
        <SolidColorBrush x:Key="ScrollThumbDraggingBrush" Color="#CC929EAD"/>
        <Thickness x:Key="ContentMargin">4</Thickness>
        <Thickness x:Key="ChatRowMargin">4,1</Thickness>
        <Thickness x:Key="ChatRowPadding">3,2</Thickness>
        <GridLength x:Key="TitleBarRowHeight">20</GridLength>
        <system:Double x:Key="TitleButtonWidth">28</system:Double>
        <system:Double x:Key="TimestampFontSize">11.5</system:Double>

        <Style x:Key="TransparentTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="3.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{StaticResource ScrollThumbDraggingBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="True"
                            Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static ScrollBar.PageUpCommand}"
                                    Style="{StaticResource TransparentTrackButtonStyle}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource OverlayScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static ScrollBar.PageDownCommand}"
                                    Style="{StaticResource TransparentTrackButtonStyle}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="{StaticResource TitleButtonWidth}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TitleButtonForegroundBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TitleButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource TitleBarButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CloseButtonHoverBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="NewChatHighlight"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <SolidColorBrush Color="Transparent"/>
                                </Border.Background>
                            </Border>
                            <ContentPresenter
                                x:Name="AnimatedContent"
                                Opacity="0">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform
                                        Y="{StaticResource ChatRowAnimationOffsetY}"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                            <Border
                                Height="1"
                                Margin="4,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource ChatSeparatorBrush}"
                                IsHitTestVisible="False"
                                Visibility="{Binding Tag.ShowChatSeparators,
                                    RelativeSource={RelativeSource AncestorType={x:Type ListBox}},
                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="AnimatedContent"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="{StaticResource ChatRowAnimationDuration}">
                                            <DoubleAnimation.EasingFunction>
                                                <PowerEase
                                                    Power="4"
                                                    EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="AnimatedContent"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="{StaticResource ChatRowAnimationOffsetY}"
                                            To="0"
                                            Duration="{StaticResource ChatRowAnimationDuration}">
                                            <DoubleAnimation.EasingFunction>
                                                <PowerEase
                                                    Power="4"
                                                    EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger
                    Property="ItemsControl.AlternationIndex"
                    Value="1">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource ChatZebraStripeBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        Background="Transparent"
        CornerRadius="6">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TitleBarRowHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.RowSpan="2"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False"
                Opacity="{DynamicResource WindowDecorationOpacity}"/>

            <Grid
                x:Name="TitleBarRoot"
                Background="Transparent"
                IsHitTestVisible="True"
                PreviewMouseLeftButtonDown="TitleBarRoot_PreviewMouseLeftButtonDown">
                <Grid
                    IsHitTestVisible="False"
                    Opacity="{DynamicResource WindowDecorationOpacity}">
                    <Border
                        x:Name="MenuBackgroundBorder"
                        Background="#FF080B10"
                        CornerRadius="5,5,0,0"/>

                    <Border
                        Background="{StaticResource TitleBarOverlayBrush}"
                        CornerRadius="5,5,0,0"/>

                    <Border
                        BorderBrush="{StaticResource TitleBarDividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="5,5,0,0"/>
                </Grid>

                <Grid Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Background="Transparent"/>

                        <Button
                            Grid.Column="1"
                            Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="SettingsButton_Click"/>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            FontSize="14"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="ExitButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="{StaticResource ContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    x:Name="DebugPanel"
                    Padding="10"
                    Margin="0,0,0,4"
                    Background="{StaticResource DebugPanelBrush}"
                    BorderBrush="{StaticResource DebugPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">

                    <StackPanel>
                        <TextBlock
                            Text="パケット取得状況"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"/>

                        <TextBlock
                            x:Name="CaptureStatusText"
                            Text="起動処理中..."
                            FontSize="14"/>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock
                                x:Name="PacketCountText"
                                Text="Npcap取得パケット数: 0"
                                FontSize="14"
                                Margin="0,0,24,0"/>

                            <TextBlock
                                x:Name="GameMessageCountText"
                                Text="ゲームメッセージ検出数: 0"
                                FontSize="14"
                                Margin="0,0,24,0"/>

                            <TextBlock
                                x:Name="DequeuedMessageCountText"
                                Text="解析処理済みメッセージ数: 0"
                                FontSize="14"/>
                        </WrapPanel>

                        <TextBlock
                            x:Name="LastPacketTimeText"
                            Text="最終パケット取得時刻: 未取得"
                            FontSize="14"
                            Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Border
                        x:Name="ChatBackgroundBorder"
                        Background="Black"
                        CornerRadius="4"
                        Opacity="{DynamicResource ChatBackgroundOpacity}"/>

                    <Border
                        Background="Transparent">

                        <ListBox
                            x:Name="ChatListBox"
                            AlternationCount="2"
                            ItemsSource="{Binding ChatMessages}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="15"
                            Padding="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.Resources>
                                <Style
                                    BasedOn="{StaticResource OverlayScrollBarStyle}"
                                    TargetType="ScrollBar"/>
                            </ListBox.Resources>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="{StaticResource ChatRowMargin}"
                                        Padding="{StaticResource ChatRowPadding}"
                                        CornerRadius="2"
                                        Background="{Binding IsMention, Converter={StaticResource MentionHighlightConverter}}">
                                    <Grid Opacity="{DynamicResource ChatTextOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                            Foreground="{StaticResource TimestampBrush}"
                                            FontSize="{StaticResource TimestampFontSize}"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding ChannelType, Converter={StaticResource ChannelNameConverter}}"
                                            Foreground="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}}"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding SenderName}"
                                            Foreground="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}, ConverterParameter=ChatText}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Margin="3,0,6,0"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding Message}"
                                            Foreground="{Binding ChannelType, Converter={StaticResource ChannelBrushConverter}, ConverterParameter=ChatText}"
                                            FontWeight="Normal"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Top"/>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="ChatCountText"
                Grid.Row="0"
                Visibility="Collapsed"
                Text="受信件数: 0"/>
        </Grid>
    </Border>
</Window>
