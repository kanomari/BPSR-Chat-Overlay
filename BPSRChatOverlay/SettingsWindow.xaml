<Window x:Class="BPSRChatOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:config="clr-namespace:BPSRChatOverlay.Config"
        Title="設定"
        Width="840"
        Height="580"
        MinWidth="760"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Meiryo UI"
        Foreground="{DynamicResource SettingsTextBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="SettingsWindowBrush" Color="#FF101216"/>
        <SolidColorBrush x:Key="SettingsTitleBarBrush" Color="#FF090A0D"/>
        <SolidColorBrush x:Key="SettingsSidebarBrush" Color="#FF15181E"/>
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#FF191D24"/>
        <SolidColorBrush x:Key="SettingsInputBrush" Color="#FF11141A"/>
        <SolidColorBrush x:Key="SettingsHoverBrush" Color="#FF252B35"/>
        <SolidColorBrush x:Key="SettingsSelectedBrush" Color="#FF222A35"/>
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#FF343A45"/>
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF2F4F7"/>
        <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#FF9AA2AE"/>
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF4F9DD9"/>
        <SolidColorBrush x:Key="SettingsAccentHoverBrush" Color="#FF65AFE7"/>
        <SolidColorBrush x:Key="SettingsDangerHoverBrush" Color="#FFC94A4A"/>
        <SolidColorBrush x:Key="SettingsThumbBrush" Color="#667D8794"/>
        <SolidColorBrush x:Key="SettingsThumbHoverBrush" Color="#AA9AA4B1"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ComboToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ClosedComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="8,0,4,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem,
                                                                                    RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{DynamicResource SettingsTextBrush}"/>
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{DynamicResource SettingsMutedTextBrush}"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClosedComboBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource SettingsHoverBrush}"/>
                                                <Setter TargetName="ClosedComboBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ComboToggleButton}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                                          ElementName=ComboToggleButton}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0"
                                        Background="{DynamicResource SettingsInputBrush}"
                                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup"
                                        Property="MinHeight"
                                        Value="32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ComboItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ComboItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SettingsInputBrush}"
                                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Width="9"
                                  Height="7"
                                  HorizontalAlignment="Left"
                                  Margin="3,0,0,0"
                                  VerticalAlignment="Center"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Data="M 0 3 L 3 6 L 9 0"
                                  Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CategoryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsSelectedBrush}"/>
                                <Setter TargetName="CategoryBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SettingsScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource SettingsThumbBrush}"
                                CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SettingsWindowBrush}"
            BorderBrush="{DynamicResource SettingsBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SettingsTitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource SettingsTitleBarBrush}"
                  MouseLeftButtonDown="SettingsTitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="設定"
                           Margin="14,0"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <Button Grid.Column="1"
                        Content="×"
                        ToolTip="閉じる"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CancelButton_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SettingsSidebarBrush}"
                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ListBox x:Name="CategoryListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CategoryItemStyle}"
                             SelectionChanged="CategoryListBox_SelectionChanged">
                        <ListBoxItem Content="表示" Tag="Display"/>
                        <ListBoxItem Content="チャット" Tag="Chat"/>
                        <ListBoxItem Content="色" Tag="Color"/>
                        <ListBoxItem Content="ネットワーク" Tag="Network"/>
                        <ListBoxItem Content="詳細" Tag="Advanced"/>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1" Margin="24,20,18,18">
                    <ScrollViewer x:Name="DisplaySettingsPanel"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="表示" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="フォントサイズ"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="FontSizeSlider"
                                                Minimum="8"
                                                Maximum="48"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Text, ElementName=FontSizeTextBox,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Name="FontSizeTextBox"
                                                 Visibility="Collapsed"/>
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Value, ElementName=FontSizeSlider,
                                                                  StringFormat={}{0:0}px}"/>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="チャット背景不透明度" Margin="0,16,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="BackgroundOpacitySlider"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Text, ElementName=BackgroundOpacityTextBox,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Name="BackgroundOpacityTextBox"
                                                     Visibility="Collapsed"/>
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Value, ElementName=BackgroundOpacitySlider,
                                                                      StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                        <TextBlock Text="チャット欄背景の透明度を調整します。"
                                                   Style="{StaticResource DescriptionStyle}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="チャット文字不透明度" Margin="0,16,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="TextOpacitySlider"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Text, ElementName=TextOpacityTextBox,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Name="TextOpacityTextBox"
                                                     Visibility="Collapsed"/>
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Value, ElementName=TextOpacitySlider,
                                                                      StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                        <TextBlock Text="チャット文字の透明度を調整します。"
                                                   Style="{StaticResource DescriptionStyle}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Text="メニューバー背景不透明度"
                                               Margin="0,16,0,0"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="MenuBackgroundOpacitySlider"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Text, ElementName=MenuBackgroundOpacityTextBox,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Name="MenuBackgroundOpacityTextBox"
                                                     Visibility="Collapsed"/>
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Value, ElementName=MenuBackgroundOpacitySlider,
                                                                      StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                        <TextBlock Text="タイトルバーと外枠の透明度を調整します。"
                                                   Style="{StaticResource DescriptionStyle}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4"
                                               Text="時刻列の幅"
                                               Margin="0,16,0,0"/>
                                    <Grid Grid.Row="4"
                                          Grid.Column="1"
                                          Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="TimeColumnWidthSlider"
                                                Minimum="36"
                                                Maximum="80"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Text, ElementName=TimeColumnWidthTextBox,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Name="TimeColumnWidthTextBox"
                                                 Visibility="Collapsed"/>
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Value, ElementName=TimeColumnWidthSlider,
                                                                  StringFormat={}{0:0}px}"/>
                                    </Grid>

                                    <TextBlock Grid.Row="5"
                                               Text="名前列の幅"
                                               Margin="0,16,0,0"/>
                                    <Grid Grid.Row="5"
                                          Grid.Column="1"
                                          Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SenderNameColumnWidthSlider"
                                                Minimum="60"
                                                Maximum="240"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Text, ElementName=SenderNameColumnWidthTextBox,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Name="SenderNameColumnWidthTextBox"
                                                 Visibility="Collapsed"/>
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Value, ElementName=SenderNameColumnWidthSlider,
                                                                  StringFormat={}{0:0}px}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="TopMostCheckBox"
                                              Content="常に最前面に表示する"/>
                                    <CheckBox x:Name="ClickThroughCheckBox"
                                              Content="クリック透過を有効にする"/>
                                    <CheckBox x:Name="HighlightNewChatRowsCheckBox"
                                              Content="新着チャットの背景を一時的に強調する"/>
                                    <CheckBox x:Name="ShowChatSeparatorsCheckBox"
                                              Content="チャット間に区切り線を表示する"/>
                                    <CheckBox x:Name="ShowChatZebraStripesCheckBox"
                                              Content="チャットの背景を交互に表示する"/>
                                    <CheckBox x:Name="ShowChatColorBandCheckBox"
                                              Content="色帯を表示する"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="色帯の位置"/>
                                        <ComboBox x:Name="ChatColorBandPositionComboBox"
                                                  Grid.Column="1"
                                                  IsEnabled="{Binding IsChecked,
                                                                      ElementName=ShowChatColorBandCheckBox}">
                                            <ComboBoxItem
                                                Content="左"
                                                Tag="{x:Static config:AppConfig.ChatColorBandPositionLeft}"/>
                                            <ComboBoxItem
                                                Content="右"
                                                Tag="{x:Static config:AppConfig.ChatColorBandPositionRight}"/>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="ShowDebugPanelCheckBox"
                                              Content="【Debug用】通信確認パネルを表示する"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ChatSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="チャット" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="オーバーレイへ表示するチャット種別を選択します。"
                                       Style="{StaticResource DescriptionStyle}"
                                       Margin="0,0,0,14"/>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="ShowWorldChatCheckBox" Content="ワールド"/>
                                    <CheckBox x:Name="ShowChannelChatCheckBox"
                                              Grid.Column="1" Content="チャンネル"/>
                                    <CheckBox x:Name="ShowPartyChatCheckBox"
                                              Grid.Row="1" Content="パーティ"/>
                                    <CheckBox x:Name="ShowGuildChatCheckBox"
                                              Grid.Row="1" Grid.Column="1" Content="ギルド"/>
                                    <CheckBox x:Name="ShowNewbieChatCheckBox"
                                              Grid.Row="2" Content="初心者チャット"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ColorSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="色" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="チャット文字色"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="ワールド"/>
                                        <Border x:Name="WorldChatTextColorPreview" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Column="2" Content="変更" Tag="WorldChatTextColor" Margin="0,4"
                                                Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="1" Text="チャンネル"/>
                                        <Border x:Name="ChannelChatTextColorPreview" Grid.Row="1" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="ChannelChatTextColor" Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="2" Text="パーティ"/>
                                        <Border x:Name="PartyChatTextColorPreview" Grid.Row="2" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="PartyChatTextColor" Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="3" Text="ギルド"/>
                                        <Border x:Name="GuildChatTextColorPreview" Grid.Row="3" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="3" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="GuildChatTextColor" Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="4" Text="初心者チャット"/>
                                        <Border x:Name="NewbieChatTextColorPreview" Grid.Row="4" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="NewbieChatTextColor" Click="ColorButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="背景色" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="チャット背景"/>
                                        <Border x:Name="ChatBackgroundColorPreview" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Column="2" Content="変更" Tag="ChatBackgroundColor" Margin="0,4"
                                                Click="ColorButton_Click"/>
                                        <TextBlock Grid.Row="1" Text="メニュー背景"/>
                                        <Border x:Name="MenuBackgroundColorPreview" Grid.Row="1" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="MenuBackgroundColor" Click="ColorButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="NetworkSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="ネットワーク" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ネットワークカード" FontWeight="SemiBold"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CaptureDeviceComboBox"
                                                  HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource SettingsTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1"
                                                Content="再読み込み"
                                                Margin="10,0,0,0"
                                                Click="ReloadCaptureDevicesButton_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="CaptureDeviceStatusText"
                                               Margin="0,8,0,0"
                                               Foreground="#FFFF7777"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                    <TextBlock Text="変更は次回起動時に反映されます。"
                                               Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AdvancedSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="詳細" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="キーワードフィルター" FontWeight="SemiBold"/>
                                    <TextBlock Text="入力したキーワードを含むチャットのみ表示します。"
                                               Style="{StaticResource DescriptionStyle}"/>
                                    <TextBox x:Name="ChatFilterKeywordsTextBox"
                                             Height="72"
                                             Margin="0,10,0,0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="スペースまたは改行で複数指定できます。"
                                               Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ハイライト設定" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="EnableMentionNotificationCheckBox"
                                              Content="キーワードをハイライト表示する"
                                              Margin="0,10,0,2"/>
                                    <CheckBox x:Name="EnableMentionSoundCheckBox"
                                              Content="通知音を鳴らす"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableMentionNotificationCheckBox}"/>
                                    <TextBlock Text="ハイライトするキーワード" Margin="0,12,0,0"/>
                                    <TextBlock Text="指定したキーワードを含むチャットを背景色で強調表示します。"
                                               Style="{StaticResource DescriptionStyle}"/>
                                    <TextBox x:Name="MentionKeywordsTextBox"
                                             Height="60"
                                             Margin="0,7,0,0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="スペースまたは改行で複数指定できます。"
                                               Style="{StaticResource DescriptionStyle}"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ハイライト背景色"/>
                                        <Border x:Name="MentionHighlightColorPreview" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Column="2" Content="変更"
                                                Tag="MentionHighlightColor"
                                                Click="ColorButton_Click"/>
                                    </Grid>

                                    <TextBlock Text="通知音ファイル" Margin="0,14,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MentionSoundFilePathTextBox"
                                                 IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="参照"
                                                Margin="8,0,0,0"
                                                Click="BrowseMentionSoundButton_Click"/>
                                        <Button Grid.Column="2" Content="クリア"
                                                Margin="6,0,0,0"
                                                Click="ClearMentionSoundButton_Click"/>
                                    </Grid>
                                    <Button Content="テスト再生"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="TestMentionSoundButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SettingsTitleBarBrush}"
                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="16,0">
                    <Button Content="キャンセル"
                            Width="96"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button Content="保存"
                            Width="96"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
