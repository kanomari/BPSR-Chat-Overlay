<Window x:Class="BPSRChatOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表示設定"
        Width="460"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="フォントサイズ:"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="FontSizeTextBox"
                Grid.Column="1"
                Width="100"
                HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="背景不透明度:"
                VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBox
                    x:Name="BackgroundOpacityTextBox"
                    Width="100"
                    HorizontalAlignment="Left"/>
                <TextBlock
                    Text="背景の濃さを0.0～1.0で入力してください。"
                    Margin="0,4,0,0"
                    Foreground="#606060"
                    FontSize="12"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="文字不透明度:"
                VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBox
                    x:Name="TextOpacityTextBox"
                    Width="100"
                    HorizontalAlignment="Left"/>
                <TextBlock
                    Text="チャット文字の濃さを0.0～1.0で入力してください。"
                    Margin="0,4,0,0"
                    Foreground="#606060"
                    FontSize="12"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="メニューバー背景不透明度:"
                VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBox
                    x:Name="MenuBackgroundOpacityTextBox"
                    Width="100"
                    HorizontalAlignment="Left"/>
                <TextBlock
                    Text="メニューバー背景の濃さを0.0～1.0で入力してください。"
                    Margin="0,4,0,0"
                    Foreground="#606060"
                    FontSize="12"/>
            </StackPanel>
        </Grid>

        <CheckBox
            x:Name="TopMostCheckBox"
            Grid.Row="4"
            Content="常に最前面に表示する"
            Margin="120,16,0,0"/>

        <CheckBox
            x:Name="ClickThroughCheckBox"
            Grid.Row="5"
            Content="クリック透過を有効にする"
            Margin="120,16,0,0"/>

        <GroupBox
            Grid.Row="6"
            Header="表示するチャット"
            Margin="0,16,0,0">
            <StackPanel Margin="12,8">
                <CheckBox
                    x:Name="ShowWorldChatCheckBox"
                    Content="ワールド"/>
                <CheckBox
                    x:Name="ShowChannelChatCheckBox"
                    Content="チャンネル"
                    Margin="0,8,0,0"/>
                <CheckBox
                    x:Name="ShowPartyChatCheckBox"
                    Content="パーティ"
                    Margin="0,8,0,0"/>
                <CheckBox
                    x:Name="ShowGuildChatCheckBox"
                    Content="ギルド"
                    Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>

        <StackPanel
            Grid.Row="7"
            Margin="0,16,0,0">
            <TextBlock Text="キーワードフィルター"/>
            <TextBox
                x:Name="ChatFilterKeywordsTextBox"
                Height="64"
                Margin="0,6,0,0"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"/>
            <TextBlock
                Text="スペースまたは改行で複数指定できます"
                Margin="0,4,0,0"
                Foreground="#606060"
                FontSize="12"/>
        </StackPanel>

        <StackPanel
            Grid.Row="9"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Content="保存"
                Width="80"
                Margin="0,0,8,0"
                IsDefault="True"
                Click="SaveButton_Click"/>
            <Button
                Content="キャンセル"
                Width="80"
                IsCancel="True"
                Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
