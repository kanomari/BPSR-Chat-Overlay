<Window x:Class="BPSRChatOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:config="clr-namespace:BPSRChatOverlay.Config"
        Title="BPSR Chat Overlay - 設定"
        Width="840"
        Height="580"
        MinWidth="760"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Meiryo UI"
        Foreground="{DynamicResource SettingsTextBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="SettingsWindowBrush" Color="#FF282C33"/>
        <SolidColorBrush x:Key="SettingsTitleBarBrush" Color="#FF38404B"/>
        <SolidColorBrush x:Key="SettingsFooterBrush" Color="#FF38404B"/>
        <SolidColorBrush x:Key="SettingsSidebarBrush" Color="#FF2D333C"/>
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#FF323741"/>
        <SolidColorBrush x:Key="SettingsInputBrush" Color="#FF262B33"/>
        <SolidColorBrush x:Key="SettingsHoverBrush" Color="#FF424A56"/>
        <SolidColorBrush x:Key="SettingsSelectedBrush" Color="#FF42505F"/>
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#FF464E5A"/>
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF2F4F7"/>
        <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#FFB1B9C4"/>
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF5F748A"/>
        <SolidColorBrush x:Key="SettingsAccentHoverBrush" Color="#FF70879E"/>
        <SolidColorBrush x:Key="SettingsAccentPressedBrush" Color="#FF4E6276"/>
        <SolidColorBrush x:Key="SettingsAccentForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SettingsBrandAccentBrush" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="SettingsNoticeBrush" Color="#334E6276"/>
        <SolidColorBrush x:Key="SettingsDangerHoverBrush" Color="#FFC94A4A"/>
        <SolidColorBrush x:Key="SettingsThumbBrush" Color="#AA6B7887"/>
        <SolidColorBrush x:Key="SettingsThumbHoverBrush" Color="#CC8190A0"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="NoticeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccentHoverBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SettingsAccentForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PrimaryButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource SettingsAccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ComboToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ClosedComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="8,0,4,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem,
                                                                                    RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{DynamicResource SettingsTextBrush}"/>
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{DynamicResource SettingsMutedTextBrush}"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClosedComboBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource SettingsHoverBrush}"/>
                                                <Setter TargetName="ClosedComboBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ComboToggleButton}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                                          ElementName=ComboToggleButton}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0"
                                        Background="{DynamicResource SettingsInputBrush}"
                                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup"
                                        Property="MinHeight"
                                        Value="32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource SettingsAccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ComboItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ComboItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="SliderFocusBorder"
                                Padding="2"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid Height="18">
                                <Track x:Name="PART_Track"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Command="{x:Static Slider.DecreaseLarge}"
                                            Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource SettingsAccentBrush}"
                                                            CornerRadius="2"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="SliderThumb"
                                                            Background="{DynamicResource SettingsAccentBrush}"
                                                            BorderBrush="{DynamicResource SettingsAccentForegroundBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SliderThumb"
                                                                    Property="Background"
                                                                    Value="{DynamicResource SettingsAccentHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="SliderThumb"
                                                                    Property="Background"
                                                                    Value="{DynamicResource SettingsAccentPressedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            Command="{x:Static Slider.IncreaseLarge}"
                                            Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource SettingsInputBrush}"
                                                            BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                            BorderThickness="0,1,0,0"
                                                            CornerRadius="2"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SliderFocusBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SliderFocusBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SettingsInputBrush}"
                                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Width="9"
                                  Height="7"
                                  HorizontalAlignment="Left"
                                  Margin="3,0,0,0"
                                  VerticalAlignment="Center"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Data="M 0 3 L 3 6 L 9 0"
                                  Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RadioBorder"
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SettingsInputBrush}"
                                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <Ellipse x:Name="RadioMark"
                                     Width="7"
                                     Height="7"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"
                                     Fill="{DynamicResource SettingsAccentForegroundBrush}"
                                     Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="RadioBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="RadioMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RadioBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CategoryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsSelectedBrush}"/>
                                <Setter TargetName="CategoryBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SettingsScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource SettingsThumbBrush}"
                                CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SettingsWindowBrush}"
            BorderBrush="{DynamicResource SettingsBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SettingsTitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource SettingsTitleBarBrush}"
                  MouseLeftButtonDown="SettingsTitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="14,0,10,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold">
                        <Run Text="▌"
                             Foreground="{DynamicResource SettingsBrandAccentBrush}"/>
                        <Run Text=" BPSR Chat Overlay"/>
                    </TextBlock>
                    <TextBlock Text="設定"
                               Margin="18,0,0,0"
                               FontSize="10"
                               FontWeight="Normal"
                               Foreground="{DynamicResource SettingsMutedTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        ToolTip="閉じる"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CancelButton_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SettingsSidebarBrush}"
                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ListBox x:Name="CategoryListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CategoryItemStyle}"
                             SelectionChanged="CategoryListBox_SelectionChanged">
                        <ListBoxItem Content="表示" Tag="Display"/>
                        <ListBoxItem Content="表示チャット" Tag="Chat"/>
                        <ListBoxItem Content="色" Tag="Color"/>
                        <ListBoxItem Content="トーク" Tag="Talk"/>
                        <ListBoxItem Content="ネットワーク" Tag="Network"/>
                        <ListBoxItem Content="フィルター" Tag="Advanced"/>
                        <ListBoxItem Content="About" Tag="About"/>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1" Margin="24,20,18,18">
                    <ScrollViewer x:Name="DisplaySettingsPanel"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="表示" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="レイアウト"
                                               Style="{StaticResource GroupTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="フォントサイズ"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="FontSizeSlider"
                                                    Minimum="8"
                                                    Maximum="48"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Text, ElementName=FontSizeTextBox,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Name="FontSizeTextBox"
                                                     Visibility="Collapsed"/>
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Value, ElementName=FontSizeSlider,
                                                                      StringFormat={}{0:0}px}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="チャットフォント"
                                                   Margin="0,16,0,0"/>
                                        <ComboBox x:Name="ChatFontFamilyComboBox"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  Margin="0,12,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="{Binding}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <CheckBox x:Name="EnableBoldMessageTextCheckBox"
                                                  Grid.Row="2"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,14,0,0"
                                                  Content="本文を太字で表示する"/>

                                        <CheckBox x:Name="EnableChatTextShadowCheckBox"
                                                  Grid.Row="3"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,8,0,0"
                                                  Content="テキストに影を付ける"/>

                                        <TextBlock Grid.Row="4"
                                                   Text="影の色"
                                                   Margin="0,14,0,0"/>
                                        <Grid Grid.Row="4"
                                              Grid.Column="1"
                                              Margin="0,10,0,0"
                                              IsEnabled="{Binding IsChecked,
                                                                  ElementName=EnableChatTextShadowCheckBox}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ChatTextShadowColorPreview"
                                                    Width="34"
                                                    Height="22"
                                                    HorizontalAlignment="Left"
                                                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"/>
                                            <Button Grid.Column="1"
                                                    Content="変更"
                                                    Tag="ChatTextShadowColor"
                                                    Click="ColorButton_Click"/>
                                        </Grid>

                                        <TextBlock Grid.Row="5"
                                                   Text="時刻列の幅"
                                                   Margin="0,16,0,0"/>
                                        <Grid Grid.Row="5"
                                              Grid.Column="1"
                                              Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="TimeColumnWidthSlider"
                                                    Minimum="36"
                                                    Maximum="80"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Text, ElementName=TimeColumnWidthTextBox,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Name="TimeColumnWidthTextBox"
                                                     Visibility="Collapsed"/>
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Value, ElementName=TimeColumnWidthSlider,
                                                                      StringFormat={}{0:0}px}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="6"
                                                   Text="名前列の幅"
                                                   Margin="0,16,0,0"/>
                                        <Grid Grid.Row="6"
                                              Grid.Column="1"
                                              Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SenderNameColumnWidthSlider"
                                                    Minimum="60"
                                                    Maximum="240"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Text, ElementName=SenderNameColumnWidthTextBox,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Name="SenderNameColumnWidthTextBox"
                                                     Visibility="Collapsed"/>
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Value, ElementName=SenderNameColumnWidthSlider,
                                                                      StringFormat={}{0:0}px}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="透明度"
                                               Style="{StaticResource GroupTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="メニューバー背景不透明度"/>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="MenuBackgroundOpacitySlider"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Text, ElementName=MenuBackgroundOpacityTextBox,
                                                                        Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox x:Name="MenuBackgroundOpacityTextBox"
                                                         Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding Value, ElementName=MenuBackgroundOpacitySlider,
                                                                          StringFormat={}{0:0.00}}"/>
                                            </Grid>
                                            <TextBlock Text="タイトルバーと外枠の透明度を調整します。"
                                                       Style="{StaticResource DescriptionStyle}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   Text="チャット背景不透明度"
                                                   Margin="0,16,0,0"/>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="BackgroundOpacitySlider"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Text, ElementName=BackgroundOpacityTextBox,
                                                                        Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox x:Name="BackgroundOpacityTextBox"
                                                         Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding Value, ElementName=BackgroundOpacitySlider,
                                                                          StringFormat={}{0:0.00}}"/>
                                            </Grid>
                                            <TextBlock Text="チャット欄背景の透明度を調整します。"
                                                       Style="{StaticResource DescriptionStyle}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2"
                                                   Text="チャット文字不透明度"
                                                   Margin="0,16,0,0"/>
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="TextOpacitySlider"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Text, ElementName=TextOpacityTextBox,
                                                                        Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox x:Name="TextOpacityTextBox"
                                                         Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding Value, ElementName=TextOpacitySlider,
                                                                          StringFormat={}{0:0.00}}"/>
                                            </Grid>
                                            <TextBlock Text="チャット文字の透明度を調整します。"
                                                       Style="{StaticResource DescriptionStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ウィンドウ"
                                               Style="{StaticResource GroupTitleStyle}"/>
                                    <CheckBox x:Name="TopMostCheckBox"
                                              Content="常に最前面に表示する"/>
                                    <CheckBox x:Name="ClickThroughCheckBox"
                                              Content="クリック透過を有効にする"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="チャット表示"
                                               Style="{StaticResource GroupTitleStyle}"/>
                                    <CheckBox x:Name="HighlightNewChatRowsCheckBox"
                                              Content="新着チャットの背景を一時的に強調する"/>
                                    <CheckBox x:Name="ShowChatSeparatorsCheckBox"
                                              Content="チャット間に区切り線を表示する"/>
                                    <CheckBox x:Name="ShowChatZebraStripesCheckBox"
                                              Content="チャットの背景を交互に表示する"/>
                                    <CheckBox x:Name="ShowChatColorBandCheckBox"
                                              Content="色帯を表示する"/>
                                    <Grid Margin="24,4,0,6"
                                          IsEnabled="{Binding IsChecked,
                                                              ElementName=ShowChatColorBandCheckBox}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="色帯位置"/>
                                        <ComboBox x:Name="ChatColorBandPositionComboBox"
                                                  Grid.Column="1">
                                            <ComboBoxItem
                                                Content="左"
                                                Tag="{x:Static config:AppConfig.ChatColorBandPositionLeft}"/>
                                            <ComboBoxItem
                                                Content="右"
                                                Tag="{x:Static config:AppConfig.ChatColorBandPositionRight}"/>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="ShowChatToggleButtonsCheckBox"
                                              Content="Overlayにチャット切り替えボタンを表示する"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="デバッグ"
                                               Style="{StaticResource GroupTitleStyle}"/>
                                    <CheckBox x:Name="ShowDebugPanelCheckBox"
                                              Content="通信確認パネルを表示する"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ChatSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="表示チャット" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="オーバーレイへ表示するチャット種別を選択します。"
                                       Style="{StaticResource DescriptionStyle}"
                                       Margin="0,0,0,14"/>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="ShowWorldChatCheckBox" Content="ワールド"/>
                                    <CheckBox x:Name="ShowChannelChatCheckBox"
                                              Grid.Column="1" Content="チャンネル"/>
                                    <CheckBox x:Name="ShowGuildChatCheckBox"
                                              Grid.Row="1" Content="ギルド"/>
                                    <CheckBox x:Name="ShowNewbieChatCheckBox"
                                              Grid.Row="1" Grid.Column="1"
                                              Content="初心者チャット"/>
                                    <CheckBox x:Name="ShowPartyChatCheckBox"
                                              Grid.Row="2" Content="パーティ"/>
                                    <CheckBox x:Name="ShowTalkChatCheckBox"
                                              Grid.Row="2" Grid.Column="1"
                                              Content="✉ トーク"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ColorSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="色" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="チャット文字色"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="ワールド"/>
                                        <Border x:Name="WorldChatTextColorPreview" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Column="2" Content="変更" Tag="WorldChatTextColor" Margin="0,4"
                                                Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="1" Text="ギルド"/>
                                        <Border x:Name="GuildChatTextColorPreview" Grid.Row="1" Grid.Column="1"
                                                 Width="34" Height="22"
                                                 BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                 BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="GuildChatTextColor" Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="2" Text="パーティ"/>
                                        <Border x:Name="PartyChatTextColorPreview" Grid.Row="2" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="PartyChatTextColor" Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="3" Text="チャンネル"/>
                                        <Border x:Name="ChannelChatTextColorPreview" Grid.Row="3" Grid.Column="1"
                                                 Width="34" Height="22"
                                                 BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                 BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="3" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="ChannelChatTextColor" Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="4" Text="初心者チャット"/>
                                        <Border x:Name="NewbieChatTextColorPreview" Grid.Row="4" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="NewbieChatTextColor" Click="ColorButton_Click"/>

                                        <TextBlock Grid.Row="5" Text="✉ トーク"/>
                                        <Border x:Name="TalkChatTextColorPreview" Grid.Row="5" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="5" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="TalkChatTextColor" Click="ColorButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="背景色" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="チャット背景"/>
                                        <Border x:Name="ChatBackgroundColorPreview" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Column="2" Content="変更" Tag="ChatBackgroundColor" Margin="0,4"
                                                Click="ColorButton_Click"/>
                                        <TextBlock Grid.Row="1" Text="メニュー背景"/>
                                        <Border x:Name="MenuBackgroundColorPreview" Grid.Row="1" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="変更" Margin="0,4"
                                                Tag="MenuBackgroundColor" Click="ColorButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="TalkSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="トーク" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="トーク設定" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="EnableTalkHighlightCheckBox"
                                              Content="トークをハイライトする"
                                              Margin="0,10,0,2"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="トークハイライト背景色"/>
                                        <Border x:Name="TalkHighlightBackgroundColorPreview"
                                                Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Column="2"
                                                Content="変更"
                                                Tag="TalkHighlightBackgroundColor"
                                                Click="ColorButton_Click"/>
                                    </Grid>

                                    <CheckBox x:Name="EnableTalkSoundCheckBox"
                                               Content="トーク通知音を鳴らす"
                                              Margin="0,26,0,0"/>
                                    <TextBlock Text="通知音ファイル" Margin="0,14,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TalkSoundFilePathTextBox"
                                                 IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="参照"
                                                Margin="8,0,0,0"
                                                Click="BrowseTalkSoundButton_Click"/>
                                        <Button Grid.Column="2" Content="クリア"
                                                Margin="6,0,0,0"
                                                Click="ClearTalkSoundButton_Click"/>
                                    </Grid>
                                    <Button Content="テスト再生"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="TestTalkSoundButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="NetworkSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="ネットワーク" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ネットワークカード" FontWeight="SemiBold"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CaptureDeviceComboBox"
                                                  HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource SettingsTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1"
                                                Content="再読み込み"
                                                Margin="10,0,0,0"
                                                Click="ReloadCaptureDevicesButton_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="CaptureDeviceStatusText"
                                               Margin="0,8,0,0"
                                               Foreground="#FFFF7777"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                    <Border Margin="0,12,0,0"
                                            Padding="10,8"
                                            Background="{DynamicResource SettingsNoticeBrush}"
                                            BorderBrush="{DynamicResource SettingsAccentPressedBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock
                                            Text="※ 変更後はアプリの再起動が必要です。"
                                            Style="{StaticResource NoticeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AdvancedSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="フィルター" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="キーワードフィルター" FontWeight="SemiBold"/>
                                    <TextBlock Text="入力したキーワードを含むチャットのみ表示します。"
                                               Style="{StaticResource DescriptionStyle}"/>
                                    <TextBox x:Name="ChatFilterKeywordsTextBox"
                                             Height="72"
                                             Margin="0,10,0,0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="スペースまたは改行で複数指定できます。"
                                               Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ハイライト設定" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="EnableMentionNotificationCheckBox"
                                              Content="キーワードをハイライト表示する"
                                              Margin="0,10,0,2"/>
                                    <CheckBox x:Name="EnableMentionSoundCheckBox"
                                              Content="通知音を鳴らす"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableMentionNotificationCheckBox}"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ハイライト背景色"/>
                                        <Border x:Name="MentionHighlightColorPreview" Grid.Column="1"
                                                Width="34" Height="22"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <Button Grid.Column="2" Content="変更"
                                                Tag="MentionHighlightColor"
                                                Click="ColorButton_Click"/>
                                    </Grid>

                                    <TextBlock Text="ハイライトするキーワード"
                                               Margin="0,16,0,0"/>
                                    <TextBlock Text="指定したキーワードを含むチャットを背景色で強調表示します。スペースまたは改行で複数指定できます。"
                                               Style="{StaticResource DescriptionStyle}"/>
                                    <TextBox x:Name="MentionKeywordsTextBox"
                                             Height="60"
                                             Margin="0,8,0,0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <TextBlock Text="通知音ファイル" Margin="0,14,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MentionSoundFilePathTextBox"
                                                 IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="参照"
                                                Margin="8,0,0,0"
                                                Click="BrowseMentionSoundButton_Click"/>
                                        <Button Grid.Column="2" Content="クリア"
                                                Margin="6,0,0,0"
                                                Click="ClearMentionSoundButton_Click"/>
                                    </Grid>
                                    <Button Content="テスト再生"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="TestMentionSoundButton_Click"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutSettingsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="About"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="BPSR Chat Overlay"
                                               FontSize="22"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="現在のバージョン"
                                               Margin="0,20,0,0"
                                               Foreground="{DynamicResource SettingsMutedTextBrush}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <TextBlock x:Name="CurrentVersionTextBlock"/>
                                        <Border Margin="10,0,0,0"
                                                Padding="7,2"
                                                Background="{DynamicResource SettingsNoticeBrush}"
                                                BorderBrush="{DynamicResource SettingsAccentPressedBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <TextBlock Text="Beta"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SettingsMutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <Button x:Name="CheckForUpdatesButton"
                                            Content="更新を確認"
                                            HorizontalAlignment="Left"
                                            Margin="0,12,0,0"
                                            Click="CheckForUpdatesButton_Click"/>
                                    <CheckBox x:Name="CheckForUpdatesOnStartupCheckBox"
                                              Content="起動時に更新を確認する"
                                              Margin="0,10,0,0"/>

                                    <TextBlock Text="Copyright © 2026 hojumari"
                                               Margin="0,20,0,0"/>

                                    <TextBlock Text="License"
                                               Margin="0,20,0,0"
                                               Foreground="{DynamicResource SettingsMutedTextBrush}"/>
                                    <TextBlock Text="MIT License"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="GitHub Project"
                                               Margin="0,20,0,0"
                                               Foreground="{DynamicResource SettingsMutedTextBrush}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               TextWrapping="Wrap">
                                        <Hyperlink
                                            NavigateUri="https://github.com/kanomari/BPSR-Chat-Overlay"
                                            ToolTip="GitHub Projectを既定のブラウザで開く"
                                            RequestNavigate="GitHubProjectLink_RequestNavigate">
                                            https://github.com/kanomari/BPSR-Chat-Overlay
                                        </Hyperlink>
                                    </TextBlock>

                                    <Button Content="設定・ログフォルダーを開く"
                                            HorizontalAlignment="Left"
                                            Margin="0,18,0,0"
                                            Click="OpenDataFolderButton_Click"/>

                                    <TextBlock Text="Acknowledgements"
                                               Margin="0,20,0,8"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="This application includes code derived from BPSR-ZDPS."
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Portions Copyright (c) 2025 BPSR-ZDPS contributors"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Licensed under the MIT License."
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Thanks to the BPSR-ZDPS project and contributors."
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SettingsFooterBrush}"
                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="16,0">
                    <Button Content="キャンセル"
                            Width="96"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button Content="保存"
                            Width="96"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
