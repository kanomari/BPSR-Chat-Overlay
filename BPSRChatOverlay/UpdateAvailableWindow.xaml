<Window x:Class="BPSRChatOverlay.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPSR Chat Overlay - 更新"
        Width="460"
        Height="300"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Meiryo UI"
        Foreground="#FFF2F4F7"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="DialogWindowBrush" Color="#FF282C33"/>
        <SolidColorBrush x:Key="DialogBarBrush" Color="#FF38404B"/>
        <SolidColorBrush x:Key="DialogPanelBrush" Color="#FF323741"/>
        <SolidColorBrush x:Key="DialogHoverBrush" Color="#FF424A56"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#FF464E5A"/>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#FFF2F4F7"/>
        <SolidColorBrush x:Key="DialogMutedTextBrush" Color="#FFB1B9C4"/>
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#FF5F748A"/>
        <SolidColorBrush x:Key="DialogAccentHoverBrush" Color="#FF70879E"/>
        <SolidColorBrush x:Key="DialogAccentPressedBrush" Color="#FF4E6276"/>
        <SolidColorBrush x:Key="DialogBrandAccentBrush" Color="#FFF59E0B"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource DialogAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource DialogAccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource DialogAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DialogWindowBrush}"
            BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{DynamicResource DialogBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="14,0"
                           FontSize="12"
                           FontWeight="SemiBold">
                    <Run Text="▌"
                         Foreground="{DynamicResource DialogBrandAccentBrush}"/>
                    <Run Text=" BPSR Chat Overlay"/>
                    <Run Text="    更新"
                         FontSize="10"
                         FontWeight="Normal"
                         Foreground="{DynamicResource DialogMutedTextBrush}"/>
                </TextBlock>
                <Button Grid.Column="1"
                        Content="×"
                        ToolTip="閉じる"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="SecondaryButton_Click"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="18"
                    Padding="18"
                    Background="{DynamicResource DialogPanelBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock x:Name="MessageTextBlock"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <Grid x:Name="VersionDetailsGrid"
                          Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="現在"
                                   Foreground="{DynamicResource DialogMutedTextBrush}"/>
                        <TextBlock x:Name="CurrentVersionTextBlock"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="LatestVersionLabel"
                                   Grid.Row="1"
                                   Text="最新"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource DialogMutedTextBrush}"/>
                        <TextBlock x:Name="LatestVersionTextBlock"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,12,0,0"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource DialogBarBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="16,0">
                    <Button x:Name="OpenReleasePageButton"
                            Content="ダウンロードページを開く"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OpenReleasePageButton_Click"/>
                    <Button x:Name="SecondaryButton"
                            Width="86"
                            Margin="10,0,0,0"
                            IsCancel="True"
                            Click="SecondaryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
